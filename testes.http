@baseUrl = http://localhost:8080
@dataTeste = 2026-10-16

###############################################################################
# 1. AUTENTICAÇÃO
###############################################################################

### 1.1 Login — execute primeiro
# @name login
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
  "email": "gilmar@gmail.com",
  "senha": "Teste@123456"
}

### Token retornado pelo login — usado nas requisições seguintes
@token = {{login.response.body.token}}

### 1.2 Login sem dados — esperado: erro 4xx
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{}

### 1.3 Login com senha incorreta — esperado: 401 (ou erro de autenticação equivalente)
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
  "email": "gilmar@gmail.com",
  "senha": "Teste@123456"
}

###############################################################################
# 2. USUÁRIO / PERFIL
###############################################################################

### 2.1  o perfil do usuário autenticado
GET {{baseUrl}}/api/v1/usuarios/me
Accept: application/json
Authorization: Bearer eyJhbGciOiJIUzI1NiJ9.eyJzdWIiOiJnaWxtYXJAZ21haWwuY29tIiwidXN1YXJpb0lkIjoyLCJpYXQiOjE3OTIyODcwNDAsImV4cCI6MTc5MjI5MDY0MH0.w2H6jp3mV3bK-YRRDgpjvppmL_NFRzzQHklqJW5MsZE

### 2.2 Consultar o usuário autenticado por ID
# Troque 2 pelo ID retornado em /api/v1/usuarios/me, se necessário.
GET {{baseUrl}}/api/v1/usuarios/2
Accept: application/json
Authorization: Bearer {{token}}

### 2.3 Consultar meta calórica estimada
GET {{baseUrl}}/api/v1/usuarios/me/meta-calorica
Accept: application/json
Authorization: Bearer {{token}}

### 2.4 Consultar perfil sem token — esperado: 401/403
GET {{baseUrl}}/api/v1/usuarios/me
Accept: application/json

### 2.5 Cadastrar usuário de teste
# Use um e-mail ainda não cadastrado e uma senha válida.
# @name cadastrarUsuario
POST {{baseUrl}}/api/v1/usuarios
Content-Type: application/json

{
  "nome": "Teste de Email Duplicado",
  "email": "usuario.teste.smartcarbo@example.com",
  "senha": "OutraSenha123!",
  "dataNascimento": "2005-05-15",
  "altura": 1.70,
  "peso": 65.0,
  "sexo": "Feminino",
  "objetivo": "Manter peso",
  "nivelAtividade": "Moderado",
  "restricoes": "Nenhuma",
  "condicaoSaude": "Nenhuma",
  "avaliacaoAlimentacao": 7
}

### 2.6 Cadastro com e-mail inválido — esperado: erro 4xx
POST {{baseUrl}}/api/v1/usuarios
Content-Type: application/json

{
  "nome": "Usuario Invalido",
  "email": "email-invalido",
  "senha": "SenhaTeste123!"
}

###############################################################################
# 3. REFEIÇÕES
###############################################################################

### 3.1 Listar refeições do usuário autenticado
GET {{baseUrl}}/api/v1/refeicoes
Accept: application/json
Authorization: Bearer {{token}}

### 3.2 Listar refeições por data
GET {{baseUrl}}/api/v1/refeicoes?data={{dataTeste}}
Accept: application/json
Authorization: Bearer {{token}}

### 3.3 Criar refeição de teste
# @name criarRefeicao
POST {{baseUrl}}/api/v1/refeicoes
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "nome": "Café da manhã - teste REST",
  "descricao": "Refeição criada pelo REST Client",
  "dataRefeicao": "{{dataTeste}}"
}

### ID da refeição criada
@refeicaoId = {{criarRefeicao.response.body.id}}

### 3.4 Consultar a refeição criada
GET {{baseUrl}}/api/v1/refeicoes/{{refeicaoId}}
Accept: application/json
Authorization: Bearer {{token}}

### 3.5 Atualizar a refeição criada
PUT {{baseUrl}}/api/v1/refeicoes/{{refeicaoId}}
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "nome": "Café da manhã - atualizado",
  "descricao": "Teste de atualização via REST Client",
  "dataRefeicao": "{{dataTeste}}"
}

###############################################################################
# 4. REGISTROS DE ALIMENTAÇÃO
###############################################################################

### 4.1 Listar registros alimentares do usuário autenticado
GET {{baseUrl}}/api/v1/refeicoes
Authorization: Bearer eyJhbGciOiJIUzI1NiJ9.eyJzdWIiOiJnaWxtYXJAZ21haWwuY29tIiwidXN1YXJpb0lkIjoyLCJpYXQiOjE3OTIyODIxNzgsImV4cCI6MTc5MjI4NTc3OH0.o7PviziXcHoRYAWxpU3_tRDWHjsSHenJClhArC3ON68
Accept: application/json
Accept: application/json

GET http://localhost:8080/api/v1/registros-alimentacao
Authorization: Bearer eyJhbGciOiJIUzI1NiJ9.eyJzdWIiOiJnaWxtYXJAZ21haWwuY29tIiwidXN1YXJpb0lkIjoyLCJpYXQiOjE3OTIyODQzODEsImV4cCI6MTc5MjI4Nzk4MX0.ysLa9-kL3Sj5V-GEwng9k0dKSE4tFSijAkWX3ofvw5c
Accept: application/json

### Consultar refeições cadastradas
GET http://localhost:8080/api/v1/refeicoes
Accept: application/json
Authorization: Bearer eyJhbGciOiJIUzI1NiJ9.eyJzdWIiOiJnaWxtYXJAZ21haWwuY29tIiwidXN1YXJpb0lkIjoyLCJpYXQiOjE3OTIyODQzODEsImV4cCI6MTc5MjI4Nzk4MX0.ysLa9-kL3Sj5V-GEwng9k0dKSE4tFSijAkWX3ofvw5c
Accept: application/json

### 4.2 Listar registros alimentares por data
GET {{baseUrl}}/api/v1/dashboard/resumo?data=2026-10-17
Authorization: Bearer eyJhbGciOiJIUzI1NiJ9.eyJzdWIiOiJnaWxtYXJAZ21haWwuY29tIiwidXN1YXJpb0lkIjoyLCJpYXQiOjE3OTIyODE1NzYsImV4cCI6MTc5MjI4NTE3Nn0.3QczyAaoJxPwB3go8z3D9FJUQJnVGg_P9b84eua96xo
Accept: application/json

### 4.3 Criar registro alimentar vinculado à refeição criada acima
# @name criarRegistroAlimentar
POST {{baseUrl}}/api/v1/registros-alimentacao
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "nomeAlimento": "Banana prata - teste REST",
  "quantidade": 1.0,
  "tipoRefeicao": "Café da manhã",
  "calorias": 89.0,
  "carboidratos": 23.0,
  "proteinas": 1.1,
  "gorduras": 0.3,
  "fibras": 2.0,
  "sodio": 1.0,
  "dataHora": "2026-10-16T08:00:00",
  "refeicaoId": {{refeicaoId}}
}

### ID do registro alimentar criado
@registroAlimentacaoId = {{criarRegistroAlimentar.response.body.id}}

### 4.4 Consultar registro alimentar criado
GET {{baseUrl}}/api/v1/registros-alimentacao/{{registroAlimentacaoId}}
Accept: application/json
Authorization: Bearer {{token}}

### 4.5 Atualizar registro alimentar criado
PUT {{baseUrl}}/api/v1/registros-alimentacao/{{registroAlimentacaoId}}
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "nomeAlimento": "Banana prata - teste atualizado",
  "quantidade": 1.0,
  "tipoRefeicao": "Café da manhã",
  "calorias": 90.0,
  "carboidratos": 23.0,
  "proteinas": 1.1,
  "gorduras": 0.3,
  "fibras": 2.0,
  "sodio": 1.0,
  "dataHora": "2026-10-16T08:00:00",
  "refeicaoId": {{refeicaoId}}
}

### 4.6 Criar registro alimentar sem token — esperado: 401/403
POST {{baseUrl}}/api/v1/registros-alimentacao
Content-Type: application/json

{
  "nomeAlimento": "Teste sem token",
  "quantidade": 1.0,
  "tipoRefeicao": "Lanche",
  "calorias": 50.0,
  "carboidratos": 10.0,
  "proteinas": 1.0,
  "gorduras": 0.5,
  "fibras": 1.0,
  "sodio": 1.0,
  "dataHora": "2026-10-16T15:00:00"
}

###############################################################################
# 5. HISTÓRICO DE PESO
###############################################################################

### 5.1 Listar histórico de peso
GET {{baseUrl}}/api/v1/pesos
Accept: application/json
Authorization: Bearer {{token}}

### 5.2 Criar registro de peso
# @name criarPeso
POST {{baseUrl}}/api/v1/pesos
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "peso": 68.0,
  "data": "{{dataTeste}}"
}

### ID do registro de peso retornado pela API
@pesoId = {{criarPeso.response.body.id}}

### 5.3 Consultar o registro de peso criado/retornado
GET {{baseUrl}}/api/v1/pesos
Accept: application/json
Authorization: Bearer eyJhbGciOiJIUzI1NiJ9.eyJzdWIiOiJnaWxtYXJAZ21haWwuY29tIiwidXN1YXJpb0lkIjoyLCJpYXQiOjE3OTIyODcwNDAsImV4cCI6MTc5MjI5MDY0MH0.w2H6jp3mV3bK-YRRDgpjvppmL_NFRzzQHklqJW5MsZE

### 5.4 Atualizar registro de peso
# Usa o ID retornado pelo teste 5.2. Altere o valor se não quiser testar com 67.5 kg.
PUT {{baseUrl}}/api/v1/pesos
Content-Type: application/json
Authorization: Bearer 

{
  "peso": 67.5,
  "data": "{{dataTeste}}"
}

### 5.5 Peso inválido — esperado: erro 4xx
POST {{baseUrl}}/api/v1/pesos
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "peso": 0,
  "data": "{{dataTeste}}"
}

### 5.6 Data futura — esperado: erro 4xx, se a validação estiver implementada
POST {{baseUrl}}/api/v1/pesos
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "peso": 65.0,
  "data": "2099-01-01"
}

### 5.7 Listar pesos sem token — esperado: 401/403
GET {{baseUrl}}/api/v1/pesos
Accept: application/json

###############################################################################
# 6. CONSUMO DE ÁGUA
###############################################################################

### 6.1 Registrar consumo de água (250 ml)
# @name criarAgua
POST {{baseUrl}}/api/v1/agua
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "quantidadeMl": 250
}

### ID do registro de água criado
@aguaId = {{criarAgua.response.body.id}}

### 6.2 Listar registros de água
GET {{baseUrl}}/api/v1/agua
Accept: application/json
Authorization: Bearer {{token}}

### 6.3 Consultar consumo de água por data
GET {{baseUrl}}/api/v1/agua/data/{{dataTeste}}
Accept: application/json
Authorization: Bearer {{token}}

### 6.4 Consultar registro de água criado
GET {{baseUrl}}/api/v1/agua/{{aguaId}}
Accept: application/json
Authorization: Bearer {{token}}

### 6.5 Atualizar registro de água criado (500 ml)
PUT {{baseUrl}}/api/v1/agua/{{aguaId}}
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "quantidadeMl": 500
}

###############################################################################
# 7. DASHBOARD E META CALÓRICA
###############################################################################

### 7.1 Consultar resumo do dashboard para a data de teste
GET {{baseUrl}}/api/v1/dashboard/resumo?data=2026-10-14
Accept: application/json
Authorization: Bearer {{token}}

### 7.2 Consultar evolução de calorias por período
GET {{baseUrl}}/api/v1/dashboard/calorias?inicio=2026-10-01&fim=2026-10-16
Accept: application/json
Authorization: Bearer {{token}}

### 7.3 Consultar meta calórica do usuário
GET {{baseUrl}}/api/v1/usuarios/me/meta-calorica
Accept: application/json
Authorization: Bearer {{token}}

###############################################################################
# 8. CATÁLOGO DE ATIVIDADES FÍSICAS
###############################################################################

### 8.1 Listar atividades físicas
GET {{baseUrl}}/api/v1/atividades-fisicas
Accept: application/json
Authorization: Bearer {{token}}

### 8.2 Criar atividade física de teste
# @name criarAtividade
POST {{baseUrl}}/api/v1/atividades-fisicas
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "nome": "Caminhada - teste REST",
  "descricao": "Atividade criada para validar a API",
  "duracao": 30,
  "calorias": 120
}

### ID da atividade criada
@atividadeId = {{criarAtividade.response.body.id}}

### 8.3 Consultar atividade criada
GET {{baseUrl}}/api/v1/atividades-fisicas/1
Accept: application/json
Authorization: Bearer {{token}}

### 8.4 Atualizar atividade criada
PUT {{baseUrl}}/api/v1/atividades-fisicas/1
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "nome": "Caminhada - teste atualizado",
  "descricao": "Atividade atualizada pelo REST Client",
  "duracao": 35,
  "calorias": 140
}

###############################################################################
# 9. EXCLUSÕES OPCIONAIS — NÃO EXECUTAR SEM CONFERIR OS IDs
###############################################################################
# As requisições abaixo estão comentadas para evitar apagar registros por engano.
# Remova o # apenas quando quiser testar exclusão e tiver conferido o registro.

# ### Excluir registro alimentar criado neste arquivo
# DELETE {{baseUrl}}/api/v1/registros-alimentacao/{{registroAlimentacaoId}}
# Authorization: Bearer {{token}}

# ### Excluir refeição criada neste arquivo
# DELETE {{baseUrl}}/api/v1/refeicoes/{{refeicaoId}}
# Authorization: Bearer {{token}}

# ### Excluir histórico de peso criado/retornado neste arquivo
# DELETE {{baseUrl}}/api/v1/pesos/{{pesoId}}
# Authorization: Bearer {{token}}

# ### Excluir registro de água criado neste arquivo
# DELETE {{baseUrl}}/api/v1/agua/{{aguaId}}
# Authorization: Bearer {{token}}

# ### Excluir atividade física criada neste arquivo
# DELETE {{baseUrl}}/api/v1/atividades-fisicas/{{atividadeId}}

GET {{baseUrl}}/api/v1/usuarios/me
