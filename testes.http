@baseUrl = http://localhost:8080
@dataTeste = 2026-10-21

###############################################################################
# 1. AUTENTICACAO
###############################################################################

### 1.1 Login (execute primeiro)
# @name login
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
  "email": "gilmar@gmail.com",
  "senha": "Teste@123456"
}

###
# O REST Client captura o token da resposta do login.
# Confirme se a propriedade retornada pela API se chama "token".
@token = {{login.response.body.token}}

### 1.2 Login sem dados (esperado: 4xx)
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{}

### 1.3 Login com senha incorreta (esperado: 401 ou erro equivalente)
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
  "email": "SEU_EMAIL",
  "senha": "SENHA_INCORRETA"
}

###############################################################################
# 2. PERFIL E META CALORICA
###############################################################################

### 2.1 Consultar meu perfil
GET {{baseUrl}}/api/v1/usuarios/me
Accept: application/json
Authorization: Bearer {{token}}

### 2.2 Consultar meta calorica
GET {{baseUrl}}/api/v1/usuarios/me/meta-calorica
Accept: application/json
Authorization: Bearer {{token}}

### 2.3 Consultar perfil sem token (esperado: 401/403)
GET {{baseUrl}}/api/v1/usuarios/me
Accept: application/json

### Seguir usuário 2
POST {{baseUrl}}/api/v1/comunidade/perfis/2/seguir
Authorization: Bearer {{token}}

### Listar publicações da comunidade
# @name listarComunidade
GET {{baseUrl}}/api/v1/comunidade/publicacoes
Accept: application/json
Authorization: Bearer {{token}}


### Curtir publicação 2 com o usuário 10006
POST {{baseUrl}}/api/v1/comunidade/publicacoes/2/curtida
Authorization: Bearer {{token}}


###############################################################################
# 3. NOTIFICACOES
# Execute depois de obter um token valido na secao 1.
# A tabela pode estar vazia ate que um evento gere uma notificacao.
###############################################################################

### 3.1 Listar todas as minhas notificacoes (esperado: 200 e uma lista)
# @name listarNotificacoes
GET {{baseUrl}}/api/v1/notificacoes
Accept: application/json
Authorization: Bearer {{token}}

### 3.2 Listar minhas notificacoes nao lidas (esperado: 200 e uma lista)
# @name listarNotificacoesNaoLidas
GET {{baseUrl}}/api/v1/notificacoes/nao-lidas
Accept: application/json
Authorization: Bearer {{token}}

### 3.3 Contar minhas notificacoes nao lidas (esperado: 200)
# Resposta esperada quando nao houver notificacoes nao lidas:
# { "quantidade": 0 }
GET {{baseUrl}}/api/v1/notificacoes/nao-lidas/contagem
Accept: application/json
Authorization: Bearer {{token}}

### 3.4 Marcar uma notificacao como lida
# Substitua 1 por um ID real presente na resposta de 3.1.
# Esperado: 204 se a notificacao existir e pertencer a conta autenticada.
PATCH {{baseUrl}}/api/v1/notificacoes/2/lida
Authorization: Bearer {{token}}

### 3.5 Marcar todas as minhas notificacoes como lidas (esperado: 204)
PATCH {{baseUrl}}/api/v1/notificacoes/lidas
Authorization: Bearer {{token}}

### 3.6 Tentar listar notificacoes sem token (esperado: 401/403)
GET {{baseUrl}}/api/v1/notificacoes
Accept: application/json

### 3.7 Testar isolamento: ID inexistente ou de outra conta
# Use um ID que exista e pertença a OUTRA conta para validar o isolamento.
# A API deve responder 404, sem revelar a notificacao alheia.
PATCH {{baseUrl}}/api/v1/notificacoes/999999/lida
Authorization: Bearer {{token}}

### Contar notificações não lidas
GET {{baseUrl}}/api/v1/notificacoes/nao-lidas/contagem
Accept: application/json
Authorization: Bearer {{token}}

###############################################################################
# 4. REFEICOES
###############################################################################

### 4.1 Listar minhas refeicoes
GET {{baseUrl}}/api/v1/refeicoes
Accept: application/json
Authorization: Bearer {{token}}

### 4.2 Listar refeicoes por data
GET {{baseUrl}}/api/v1/refeicoes?data={{dataTeste}}
Accept: application/json
Authorization: Bearer {{token}}

###############################################################################
# 5. REGISTROS DE ALIMENTACAO
###############################################################################

### 5.1 Listar meus registros alimentares
GET {{baseUrl}}/api/v1/registros-alimentacao
Accept: application/json
Authorization: Bearer {{token}}

### 5.2 Consultar resumo do dashboard por data
GET {{baseUrl}}/api/v1/dashboard/resumo?data={{dataTeste}}
Accept: application/json
Authorization: Bearer {{token}}

###############################################################################
# 6. HISTORICO DE PESO
###############################################################################

### 6.1 Listar meu historico de peso
GET {{baseUrl}}/api/v1/pesos
Accept: application/json
Authorization: Bearer {{token}}

###############################################################################
# 7. CONSUMO DE AGUA
###############################################################################

### 7.1 Listar meus registros de agua
GET {{baseUrl}}/api/v1/agua
Accept: application/json
Authorization: Bearer {{token}}

### 7.2 Consultar consumo de agua por data
GET {{baseUrl}}/api/v1/agua/data/{{dataTeste}}
Accept: application/json
Authorization: Bearer {{token}}

###############################################################################
# 8. DASHBOARD
###############################################################################

### 8.1 Consultar resumo do dashboard
GET {{baseUrl}}/api/v1/dashboard/resumo?data={{dataTeste}}
Accept: application/json
Authorization: Bearer {{token}}

### 8.2 Consultar evolucao de calorias por periodo
GET {{baseUrl}}/api/v1/dashboard/calorias?inicio=2026-10-01&fim={{dataTeste}}
Accept: application/json
Authorization: Bearer {{token}}

###############################################################################
# 9. ATIVIDADES FISICAS
###############################################################################

### 9.1 Listar atividades fisicas
GET {{baseUrl}}/api/v1/atividades-fisicas
Accept: application/json
Authorization: Bearer {{token}}

###############################################################################
# OBSERVACOES
# - Use sempre o token dinamico obtido na secao 1; evite tokens JWT fixos,
#   pois expiram e podem pertencer a outra conta.
# - Execute cada requisicao individualmente pelo link "Send Request".
# - Os endpoints de notificacoes nao incluem criacao manual publica: as
#   notificacoes devem ser geradas pelo backend quando eventos forem integrados.
# - Para testar PATCH /{id}/lida, primeiro precisa existir uma notificacao real.

